# 复制为 .env 后可被 docker compose / uvicorn 自动读取（前缀 COLDCHAIN_）
# 宿主机映射端口
COLDCHAIN_PORT=8000

# 数据库连接串（默认 SQLite；切换 PostgreSQL 示例见 docker-compose.yml）
COLDCHAIN_DATABASE_URL=sqlite:////data/coldchain.db

COLDCHAIN_HOST=0.0.0.0
COLDCHAIN_PORT=8000

# 温度合法范围（摄氏度，含边界）
COLDCHAIN_MIN_TEMPERATURE=-60
COLDCHAIN_MAX_TEMPERATURE=85
